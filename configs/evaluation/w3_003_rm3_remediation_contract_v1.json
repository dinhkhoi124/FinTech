      "name": "FAIL_CLOSED_FACTUAL_AND_ROUTE_AUTHORIZATION",
      "negative_safety_family": "wrong target, wrong state, missing obligation, unsupported account decision, prohibited action, and ambiguous safe-stop transformations",
      "rollback_off_switch": "rm3_fail_closed_authorization.enabled=false restores frozen RM2 while disabling EV3 authorization"
