          "derive_corrective_scope_anchor",
          "assess_requested_target"
        ],
        "src/payresolve_ai/retrieval/runtime.py": [
          "discover_corrective_candidates (behavior preserved; no semantic retriever)"
        ]
      },
      "id": "P0-C",
      "invariant": "Use the existing deterministic bounded discovery only after a safe exact scope/state anchor and only for SAFE_CORRECTIVE; discovery expands candidates but never factual authorization or STANDARD eligibility.",
      "name": "BOUNDED_SAFE_CORRECTIVE_DISCOVERY",
      "negative_safety_family": "missing anchor, wrong-state anchor, wrong-target competitor, incomplete corrective cover, and attempted STANDARD transition",
