    "if_ev3_pass": "P0_CLOSURE_REVIEW",
    "if_ev3_valid_fail": {
      "decision": "TRUTHFUL_SCOPED_RELEASE_OR_DEMO",
      "ev4": false
    },
    "if_readiness_fails": {
      "demo_scope": [
        "agent_assist_human_review",
        "safe_degraded_demo"
      ],
      "ev3_authorized": false
    }
  },
  "forbidden_scope": [
    "new embedding model",
    "new classifier",
    "BM25",
    "hybrid retrieval",
    "reranker",
    "R0-to-R1 switch",
    "global top-k increase",
    "new response taxonomy",
    "new architecture",
