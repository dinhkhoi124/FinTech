{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payresolve://schemas/kb_document_v1",
  "title": "PayResolve Synthetic KB Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "document_family_id",
    "title",
    "document_type",
    "intent_scope",
    "intent_slugs",
    "intent_family",
    "product",
    "status",
    "version",
    "effective_date",
    "expiry_date",
    "supersedes_document_id",
    "approved_by",
    "organization",
    "source_type",
    "language",
    "risk_level",
    "synthetic_disclaimer",
    "content_sections"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+_[0-9]{3}$"
    },
    "document_family_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "document_type": {
      "enum": [
        "faq",
        "policy",
        "runbook",
        "escalation_guide"
      ]
    },
    "intent_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "intent_slugs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "intent_family": {
      "enum": [
        "transfer",
        "card_payment",
        "cash_withdrawal"
      ]
    },
    "product": {
      "enum": [
        "bank_transfer",
        "card_payment",
        "cash_withdrawal"
      ]
    },
    "status": {
      "enum": [
        "APPROVED",
        "DRAFT",
        "EXPIRED"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "supersedes_document_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_by": {
      "type": "string",
      "minLength": 3
    },
    "organization": {
      "const": "PayResolve Demo Bank"
    },
    "source_type": {
      "const": "synthetic"
    },
    "language": {
      "const": "en"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "synthetic_disclaimer": {
      "type": "string",
      "minLength": 20
    },
    "content_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "heading",
          "content"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "heading": {
            "type": "string",
            "minLength": 2
          },
          "content": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  }
}
